---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ServiceCta from "../../components/ServiceCta.astro";
import { publishedPosts } from "../../posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="muted">
      <time datetime={post.data.published.toISOString()}>{fmt(post.data.published)}</time>
      {post.data.updated && <> · 수정 {fmt(post.data.updated)}</>}
    </p>
    <Content />
  </article>
  <ServiceCta />
</Base>
