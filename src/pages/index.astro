---
import Base from "../layouts/Base.astro";
import { publishedPosts } from "../posts";
const posts = await publishedPosts();
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <h1>글</h1>
  {posts.length === 0 && <p class="muted">아직 공개한 글이 없습니다.</p>}
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <time datetime={p.data.published.toISOString()}>{fmt(p.data.published)}</time>
        <a href={`/posts/${p.id}/`}>{p.data.title}</a>
        <p class="muted">{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
<style>
  .posts { list-style: none; padding: 0; }
  .posts li { margin-bottom: 1.5rem; }
  .posts time { display: block; color: var(--muted); font-size: 0.9rem; }
  .posts a { font-size: 1.15rem; font-weight: 600; }
  .posts p { margin: 0.25rem 0 0; }
</style>
